{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unified:historical-checkpoint:1",
  "title": "Historical Checkpoint v1 \u00e2\u20ac\u201d committed object, PENDING cross-agent ACK",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "instrument_id": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exchange": {
          "const": "bybit"
        },
        "category": {
          "enum": [
            "linear",
            "spot",
            "inverse",
            "option"
          ]
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
        },
        "instrument_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "exchange",
        "category",
        "symbol",
        "instrument_version"
      ]
    },
    "partition_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bybit.kline.reverse.1m.v1"
        },
        "requested_range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_ms": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            "end_ms": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ]
        },
        "request_end_ms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "requested_range",
        "request_end_ms",
        "response_sha256"
      ]
    },
    "committed_cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bybit.kline.reverse.1m.v1"
        },
        "next_end_ms": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition_frontier_ms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "coverage_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gap_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "next_end_ms",
        "disposition_frontier_ms",
        "coverage_root",
        "gap_root"
      ]
    },
    "segment_manifest_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "assignment_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "lease_epoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "fencing_token": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "lease_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "worker_incarnation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "leader_lock_index": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "assignment_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "lease_epoch": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "grant_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "cluster_generation",
        "assignment_id",
        "lease_id",
        "node_id",
        "worker_incarnation_id",
        "leader_lock_index",
        "assignment_revision",
        "lease_epoch",
        "grant_revision",
        "owner_id"
      ]
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "committed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "cluster_generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "checkpoint_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "previous_checkpoint_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "grant_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "worker_incarnation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "storage_reservation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "storage_budget_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "publication_mode": {
      "const": "authority-root"
    },
    "target_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "end_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ]
    },
    "interval_ms": {
      "const": "60000"
    },
    "checkpoint_scope": {
      "const": "dataset-partition"
    },
    "source_id": {
      "const": "bybit.public.linear.kline.1m.v1"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "instrument_id",
    "partition_id",
    "source_cursor",
    "committed_cursor",
    "segment_manifest_revision",
    "assignment_revision",
    "lease_epoch",
    "fencing_token",
    "commit_id",
    "committed_at_utc",
    "cluster_generation",
    "checkpoint_revision",
    "previous_checkpoint_sha256",
    "segment_manifest_sha256",
    "assignment_id",
    "grant_revision",
    "lease_id",
    "owner_id",
    "worker_incarnation_id",
    "storage_reservation_id",
    "storage_budget_revision",
    "publication_mode",
    "target_range",
    "interval_ms",
    "checkpoint_scope",
    "source_id",
    "cluster_id",
    "node_id"
  ],
  "description": "Structural schema only. Canonical bytes and semantic cross-object/authority predicates in historical-checkpoint-v1-spec.md are mandatory. No implementation authorization."
}
