{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unified:control-sync:v2-review2",
  "$comment": "OUTPUT-ONLY PROPOSAL; semantic/auth/barrier/domain validation mandatory; no endpoint admission.",
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/change"
    },
    {
      "$ref": "#/$defs/liveness"
    },
    {
      "$ref": "#/$defs/authority_observation"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "u63": {
      "type": "string",
      "pattern": "^(?:0|(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807))$"
    },
    "positive": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,2048}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "CONTROL",
            "DATASET"
          ]
        },
        "dataset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "source_id",
        "partition_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "partition_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CONTROL"
              }
            }
          },
          "then": {
            "properties": {
              "dataset_id": {
                "type": "null"
              },
              "source_id": {
                "type": "null"
              },
              "partition_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "dataset_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "$ref": "#/$defs/uuid"
        },
        "cluster_generation": {
          "$ref": "#/$defs/uuid"
        },
        "stream_id": {
          "$ref": "#/$defs/uuid"
        },
        "view_id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      },
      "required": [
        "cluster_id",
        "cluster_generation",
        "stream_id",
        "view_id",
        "scope"
      ]
    },
    "resource_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_type": {
          "$ref": "#/$defs/id"
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_type": {
          "$ref": "#/$defs/id"
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "domain_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "domain_revision": {
          "$ref": "#/$defs/u63"
        },
        "value": {
          "type": "object",
          "maxProperties": 64
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "domain_schema_sha256",
        "domain_revision",
        "value"
      ]
    },
    "authority_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.control.authority-observation.v2"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "observation_id": {
          "$ref": "#/$defs/uuid"
        },
        "delivery_session_id": {
          "$ref": "#/$defs/uuid"
        },
        "observation_sequence": {
          "$ref": "#/$defs/positive"
        },
        "status": {
          "enum": [
            "QUORUM_CONFIRMED",
            "NO_QUORUM",
            "UNKNOWN"
          ]
        },
        "metadata_revision": {
          "$ref": "#/$defs/u63"
        },
        "change_sequence": {
          "$ref": "#/$defs/u63"
        },
        "state_root": {
          "$ref": "#/$defs/sha256"
        },
        "authority_read_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "no_quorum_evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_started_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/u63"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_finished_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/u63"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/u63"
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_uncertainty_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/u63"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "context",
        "observation_id",
        "delivery_session_id",
        "observation_sequence",
        "status",
        "metadata_revision",
        "change_sequence",
        "state_root",
        "authority_read_ref",
        "no_quorum_evidence_ref",
        "read_started_at_ms",
        "read_finished_at_ms",
        "valid_until_ms",
        "clock_uncertainty_ms"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "QUORUM_CONFIRMED"
              }
            }
          },
          "then": {
            "properties": {
              "authority_read_ref": {
                "$ref": "#/$defs/id"
              },
              "no_quorum_evidence_ref": {
                "type": "null"
              },
              "read_started_at_ms": {
                "$ref": "#/$defs/u63"
              },
              "read_finished_at_ms": {
                "$ref": "#/$defs/u63"
              },
              "valid_until_ms": {
                "$ref": "#/$defs/u63"
              },
              "clock_uncertainty_ms": {
                "$ref": "#/$defs/u63"
              }
            }
          },
          "else": {
            "properties": {
              "valid_until_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NO_QUORUM"
              }
            }
          },
          "then": {
            "properties": {
              "no_quorum_evidence_ref": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.control.snapshot.v2"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "metadata_revision": {
          "$ref": "#/$defs/u63"
        },
        "change_sequence": {
          "$ref": "#/$defs/u63"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "state_root": {
          "$ref": "#/$defs/sha256"
        },
        "resources": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_seconds": {
              "const": "600"
            },
            "earliest_available_sequence": {
              "$ref": "#/$defs/u63"
            }
          },
          "required": [
            "minimum_seconds",
            "earliest_available_sequence"
          ]
        },
        "authority_observation": {
          "allOf": [
            {
              "$ref": "#/$defs/authority_observation"
            },
            {
              "properties": {
                "status": {
                  "const": "QUORUM_CONFIRMED"
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema",
        "context",
        "metadata_revision",
        "change_sequence",
        "cursor",
        "state_root",
        "resources",
        "retention",
        "authority_observation"
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.control.change.v2"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "change_sequence": {
          "$ref": "#/$defs/positive"
        },
        "previous_sequence": {
          "$ref": "#/$defs/u63"
        },
        "metadata_revision": {
          "$ref": "#/$defs/u63"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "previous_state_root": {
          "$ref": "#/$defs/sha256"
        },
        "state_root": {
          "$ref": "#/$defs/sha256"
        },
        "upserts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "deletes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/resource_key"
          }
        }
      },
      "required": [
        "schema",
        "context",
        "event_id",
        "change_sequence",
        "previous_sequence",
        "metadata_revision",
        "cursor",
        "previous_state_root",
        "state_root",
        "upserts",
        "deletes"
      ]
    },
    "liveness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.control.liveness.v2"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "connection_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "schema",
        "context",
        "connection_id"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.control.error.v2"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "enum": [
            "NOT_FOUND",
            "METHOD_NOT_ALLOWED",
            "INVALID_REQUEST",
            "UNAUTHENTICATED",
            "SESSION_EXPIRED",
            "FORBIDDEN",
            "REAUTH_REQUIRED",
            "CONFIRMATION_REQUIRED",
            "REVISION_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "OUTCOME_UNKNOWN",
            "NOT_LEADER",
            "NO_QUORUM",
            "RESYNC_REQUIRED",
            "RATE_LIMITED",
            "AUTHENTICATION_UNAVAILABLE",
            "AUTHORITY_UNAVAILABLE",
            "SAFETY_GATE_CLOSED",
            "UNAVAILABLE"
          ]
        },
        "reason": {
          "enum": [
            "NONE",
            "PROVIDER_NOT_ADMITTED",
            "STRICT_TIME_GATE",
            "CLOSURE_GATE",
            "DISPATCH_GATE",
            "CURSOR_EXPIRED",
            "SEQUENCE_GAP",
            "GENERATION_CHANGED",
            "VIEW_CHANGED",
            "CURSOR_INVALID",
            "BUFFER_OVERFLOW",
            "UNSUPPORTED_SCHEMA",
            "SNAPSHOT_TOO_LARGE",
            "PROJECTION_BEHIND",
            "RETENTION_UNQUALIFIED"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/u63"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "schema",
        "request_id",
        "code",
        "reason",
        "retryable",
        "retry_after_ms",
        "evidence_refs"
      ]
    }
  }
}
