@@ -0,0 +1,12 @@
+# Review4 browser adapter implementation plan
+
+Goal: executable browser-safe C3 decoding and bounded transport components for the separately versioned Control Mux profile. Frozen Sync v1 remains unchanged.
+
+Implementation checkout: existing feature/terminan-sync-v1-20261106, base HEAD 42686cd8fafcefaed3c5df5adaee5173d27543fd. Ownership remains terminan/sync/**, tests/sync/**, docs/sync/** and own workflow. Review4 dependency published in unified-system 360c5cdc9dae88416d69f8765f3dff5ab8828945; profile SHA256 335cda8e5d451fd9ab90586b6f6a4d6fbaf5f52eabb5a11762d9100ed92fefdf.
+
+1. Write failing codec tests, then implement terminan/sync/c3.js. Accept raw canonical ASCII text only, never arbitrary host object graphs. Enforce bytes, containers, keys, members, arrays, strings, node budget and numeric ban during parsing. Return opaque branded tokens and immutable detached values. Test review4 vectors, hostile host objects and browser execution.
+2. Implement bounded exact SSE record decoding with tests for arbitrary byte fragmentation, reconnect boundaries, noncanonical records and oversize buffers. This is framing only: no authority or domain admission.
+3. Coordinate actual HTTP paths, authentication context, command/session response validation and stream attachment with A2 and ROOT. Do not invent endpoints or credentials; no production mock adapter. Implement executable HTTP/session/command adapter after exact contracts are available.
+4. Verify original contract suite and new browser components. Update dependency matrix and evidence; distinguish local preliminary checks from endpoint, Windows and physical acceptance.
+
+No domain data is admitted by C3 validity. Unknown domains remain UNAVAILABLE. No C3 stream is connected to the v1 reducer, and no component grants authority or changes backend state by default.
diff --git a/terminan/sync/c3.js b/terminan/sync/c3.js
new file mode 100644
index 0000000..ffe6ee3
--- /dev/null
+++ b/terminan/sync/c3.js
@@ -0,0 +1,87 @@
+/* Review4 C3 raw-text codec. Shape validity never establishes authority.
+ * Deliberately no host-object writer: browser APIs cannot detect all Proxies.
+ */
+(function (root, factory) {
+  const api = factory();
+  if (typeof module === 'object') module.exports = api;
+  else root.TerminanC3 = api;
+})(globalThis, function () {
+  'use strict';
+  const tokens = new WeakMap();
+  const MAX_BYTES = 2097152;
+  const PROFILE_SHA256 = '335cda8e5d451fd9ab90586b6f6a4d6fbaf5f52eabb5a11762d9100ed92fefdf';
+  const BOUNDS_SHA256 = 'be9a0eb518ab14683cbb8e002e18f05e03d948b8c5d1537d635736bde8789203';
+  function fail(code) { throw new Error(code); }
+  function parse(raw, maxBytes = MAX_BYTES) {
+    if (!Number.isSafeInteger(maxBytes) || maxBytes < 1 || maxBytes > MAX_BYTES) fail('BYTE_LIMIT');
+    if (typeof raw !== 'string' || !raw.length || raw.length > maxBytes) fail('RAW_CAP');
+    let offset = 0, nodes = 0;
+    function count() { if (++nodes > 32768) fail('NODE_CAP'); }
+    function string(limit, minimum = 0) {
+      if (raw[offset++] !== '"') fail('STRING_REQUIRED');
+      let result = '';
+      while (offset < raw.length) {
+        let ch = raw[offset++];
+        if (ch === '"') {
+          if (result.length < minimum) fail('KEY_CAP');
+          return result;
+        }
+        if (ch === '\\') {
+          ch = raw[offset++];
+          if (ch !== '"' && ch !== '\\') fail('ESCAPE_ALIAS');
+        } else if (ch.charCodeAt(0) < 32 || ch.charCodeAt(0) > 126) fail('ASCII_REQUIRED');
+        result += ch;
+        if (result.length > limit) fail('STRING_CAP');
+      }
+      fail('UNTERMINATED_STRING');
+    }
+    function read(parentDepth) {
+      count();
+      const ch = raw[offset];
+      if (ch === '"') return string(16384);
+      for (const [literal, value] of [['null', null], ['true', true], ['false', false]]) {
+        if (raw.startsWith(literal, offset)) { offset += literal.length; return value; }
+      }
+      if (ch !== '[' && ch !== '{') fail('VALUE_REQUIRED_NO_NUMBERS');
+      const depth = parentDepth + 1;
+      if (depth > 12) fail('DEPTH_CAP');
+      offset++;
+      if (ch === '[') {
+        const values = [];
+        if (raw[offset] === ']') { offset++; return Object.freeze(values); }
+        while (true) {
+          if (values.length >= 1000) fail('ARRAY_CAP');
+          values.push(read(depth));
+          if (raw[offset] === ']') { offset++; return Object.freeze(values); }
+          if (raw[offset++] !== ',') fail('ARRAY_SEPARATOR');
+        }
+      }
+      const values = Object.create(null);
+      let previous = null, members = 0;
+      if (raw[offset] === '}') { offset++; return Object.freeze(values); }
+      while (true) {
+        if (++members > 64) fail('MEMBER_CAP');
+        count();
+        const key = string(128, 1);
+        if (previous !== null && key <= previous) fail('KEY_ORDER_OR_DUPLICATE');
+        previous = key;
+        if (raw[offset++] !== ':') fail('OBJECT_SEPARATOR');
+        values[key] = read(depth);
+        if (raw[offset] === '}') { offset++; return Object.freeze(values); }
+        if (raw[offset++] !== ',') fail('OBJECT_SEPARATOR');
+      }
+    }
+    const value = read(0);
+    if (offset !== raw.length) fail('TRAILING_DATA');
+    const token = Object.freeze(Object.create(null));
+    tokens.set(token, { raw, value });
+    return token;
+  }
+  function lookup(token) {
+    const entry = tokens.get(token);
+    if (!entry) fail('C3_TOKEN_REQUIRED');
+    return entry;
+  }
+  return Object.freeze({ parse, text: token => lookup(token).raw,
+    value: token => lookup(token).value, PROFILE_SHA256, BOUNDS_SHA256 });
+});
diff --git a/terminan/sync/mux-stream.js b/terminan/sync/mux-stream.js
new file mode 100644
index 0000000..b4c3044
--- /dev/null
+++ b/terminan/sync/mux-stream.js
@@ -0,0 +1,42 @@
+/* Exact Review4 SSE record framing only. Caller must validate envelope, epochs,
+ * ordering, authority and domain before applying any returned opaque C3 token.
+ */
+(function(root,factory){
+  const api=factory(typeof module==='object'?require('./c3.js'):root.TerminanC3);
+  if(typeof module==='object')module.exports=api;else root.TerminanMuxStream=api;
+})(globalThis,function(C){
+  'use strict';
+  class MuxRecords {
+    constructor(){this.buffer='';this.closed=false;}
+    close(){this.closed=true;this.buffer='';}
+    finish(){
+      if(this.closed)throw Error('STREAM_CLOSED');
+      const truncated=this.buffer.length!==0;
+      this.close();
+      if(truncated)throw Error('TRUNCATED_RECORD');
+    }
+    feed(fragment){
+      if(this.closed)throw Error('STREAM_CLOSED');
+      try{
+        if(typeof fragment!=='string'||fragment.length>2097152)throw Error('CHUNK_CAP');
+        for(let i=0;i<fragment.length;i++){
+          const char=fragment[i], code=fragment.charCodeAt(i);
+          if((code<32&&char!=='\n')||code>126)throw Error('SSE_ASCII_REQUIRED');
+        }
+        const records=[], joined=this.buffer+fragment;
+        let start=0,end;
+        while((end=joined.indexOf('\n\n',start))!==-1){
+          if(end+2-start>133128)throw Error('FRAME_CAP');
+          if(records.length>=16)throw Error('BATCH_CAP');
+          if(joined.slice(start,start+6)!=='data: ')throw Error('SSE_PREFIX');
+          records.push(C.parse(joined.slice(start+6,end),133120));
+          start=end+2;
+        }
+        this.buffer=joined.slice(start);
+        if(this.buffer.length>133128)throw Error('FRAME_CAP');
+        return records;
+      }catch(error){this.close();throw error;}
+    }
+  }
+  return Object.freeze({MuxRecords});
+});
