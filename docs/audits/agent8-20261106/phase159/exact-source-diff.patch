+name: Agent 5 one-shot negative integration
+on:
+  pull_request:
+    paths:
+      - 'tests/gateway_jobs/**'
+      - 'tests/test_intelligence_gateway.py'
+      - 'scheduler_components/**'
+      - 'unified_system/gateway_jobs.py'
+      - 'unified_system/gateway_worker.py'
+      - 'unified_system/intelligence_gateway.py'
+      - '.github/workflows/agent5-one-shot-negative.yml'
+permissions:
+  contents: read
+jobs:
+  local-negative-only:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, windows-latest]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.10'
+      - name: Local closed components only; no native worker or authority
+        shell: python -I -S -B {0}
+        env:
+          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
+          GIT_NO_REPLACE_OBJECTS: '1'
+        run: |
+          import os, subprocess, sys, unittest
+          assert sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode
+          assert subprocess.check_output(['git','--no-replace-objects','rev-parse','HEAD']).decode().strip() == os.environ['EXPECTED_HEAD']
+          sys.path.insert(0, '.')
+          patterns = ['test_one_shot_closed_integration.py', 'test_closed_jobs.py',
+                      'test_resource_capabilities.py', 'test_cpu_policy.py',
+                      'test_capacity_freshness.py', 'test_clock_source_prerequisites.py']
+          suite = unittest.TestSuite(unittest.TestLoader().discover('tests/gateway_jobs', pattern=p) for p in patterns)
+          assert suite.countTestCases() == 33
+          result = unittest.TextTestRunner(verbosity=2).run(suite)
+          assert result.wasSuccessful() and result.testsRun == 33 and not result.skipped
+          assert not subprocess.check_output(['git','--no-replace-objects','status','--porcelain','--untracked-files=all']).strip()
