+    def test_closed_types_sha_bounds_and_unknown_task(self):
+        for mutate in (lambda m:m.update(extra=True),lambda m:m.update(source_tree="c"*40+"\n"),
+                       lambda m:m["retry_budget"].update(max_retries=True),
