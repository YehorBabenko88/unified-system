diff --git a/.github/workflows/preparation-integrity.yml b/.github/workflows/preparation-integrity.yml
new file mode 100644
index 0000000..1caddb8
--- /dev/null
+++ b/.github/workflows/preparation-integrity.yml
@@ -0,0 +1,128 @@
+name: Preparation integrity exact source
+on:
+  push:
+    branches: [main]
+    paths: ['scheduler_components/**', 'tests/test_agent5_scheduler_components.py', 'tests/test_preparation_integrity.py', 'tests/test_preparation_qualification.py', 'tools/ci/qualify_preparation_integrity.py', 'docs/scheduler/component-test-inventory-v2.json', 'docs/ci/preparation-integrity-inventory-v1.json', 'docs/ci/requirements-unittest.lock', '.github/workflows/preparation-integrity.yml']
+  pull_request:
+    paths: ['scheduler_components/**', 'tests/test_agent5_scheduler_components.py', 'tests/test_preparation_integrity.py', 'tests/test_preparation_qualification.py', 'tools/ci/qualify_preparation_integrity.py', 'docs/scheduler/component-test-inventory-v2.json', 'docs/ci/preparation-integrity-inventory-v1.json', 'docs/ci/requirements-unittest.lock', '.github/workflows/preparation-integrity.yml']
+permissions:
+  contents: read
+jobs:
+  qualification:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [windows-latest, ubuntu-24.04]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 10
+    env:
+      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+      PYTHONDONTWRITEBYTECODE: '1'
+      PIP_DISABLE_PIP_VERSION_CHECK: '1'
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        env:
+          GIT_CONFIG_COUNT: '2'
+          GIT_CONFIG_KEY_0: core.autocrlf
+          GIT_CONFIG_VALUE_0: 'false'
+          GIT_CONFIG_KEY_1: core.eol
+          GIT_CONFIG_VALUE_1: lf
+        with:
+          ref: ${{ env.EXPECTED_HEAD }}
+          persist-credentials: false
+          fetch-depth: 0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.10'
+      - name: Bind runner-local path after runner assignment
+        shell: python -I -S -B {0}
+        run: |
+          import os, pathlib
+          base=pathlib.Path(os.environ['RUNNER_TEMP'])/('preparation-'+os.environ['GITHUB_RUN_ID']+'-'+os.environ['GITHUB_RUN_ATTEMPT'])
+          with open(os.environ['GITHUB_ENV'],'a',encoding='utf-8') as stream:
+              stream.write('QUALIFICATION_BASE='+str(base)+'\n')
+      - name: Download and verify pinned timezone data without importing it
+        shell: bash
+        run: |
+          python -I -S -B - <<'PY'
+          import hashlib, os, pathlib, stat, subprocess, sys, zipfile
+          root=pathlib.Path.cwd().resolve()
+          git=pathlib.Path('C:/Program Files/Git/cmd/git.exe' if os.name=='nt' else '/usr/bin/git')
+          assert git.is_absolute() and not git.is_relative_to(root)
+          for item in [git,*git.parents]:
+              info=item.lstat()
+              assert not item.is_symlink() and not getattr(info,'st_file_attributes',0)&1024
+              assert (stat.S_ISREG(info.st_mode) and info.st_nlink==1) if item==git else stat.S_ISDIR(info.st_mode)
+          assert os.name=='nt' or git.stat().st_mode&0o111
+          def raw(*args):
+              return subprocess.check_output([str(git),'--no-replace-objects','--no-optional-locks','-c','core.fsmonitor=false',*args],timeout=30)
+          head=os.environ['EXPECTED_HEAD']
+          assert raw('rev-parse','HEAD').decode().strip()==head
+          lock='docs/ci/requirements-unittest.lock'
+          assert (root/lock).read_bytes()==raw('cat-file','blob',head+':'+lock)
+          pin='1a403fada01ff9221ca8044d701868fa132215d84beb92242d9acd2147f667a8'
+          line='tzdata==2025.2 --hash=sha256:'+pin
+          assert line in (root/lock).read_text().splitlines()
+          base=pathlib.Path(os.environ['QUALIFICATION_BASE']);base.mkdir(exist_ok=False)
+          (base/'tzdata.lock').write_text(line+'\n')
+          command=[sys.executable,'-I','-B','-m','pip','--isolated','download','--no-cache-dir','--no-deps','--only-binary=:all:','--require-hashes','--dest',str(base/'wheels'),'-r',str(base/'tzdata.lock')]
+          with (base/'download.log').open('wb') as log:
+              subprocess.run(command,stdout=log,stderr=log,check=True,timeout=120)
+          wheels=list((base/'wheels').glob('*.whl'));assert len(wheels)==1
+          wheel=wheels[0];assert hashlib.sha256(wheel.read_bytes()).hexdigest()==pin
+          assert wheel.name=='tzdata-2025.2-py2.py3-none-any.whl'
+          with zipfile.ZipFile(wheel) as archive:
+              assert all(not pathlib.PurePosixPath(n).is_absolute() and '..' not in pathlib.PurePosixPath(n).parts and '\\' not in n for n in archive.namelist())
+              archive.extractall(base/'dependency')
+          PY
+      - name: Bootstrap verified qualifier and run bounded exact 36
+        shell: bash
+        run: |
+          python -I -S -B - <<'PY'
+          import hashlib, os, pathlib, stat, subprocess, sys
+          root=pathlib.Path.cwd().resolve()
+          git=pathlib.Path('C:/Program Files/Git/cmd/git.exe' if os.name=='nt' else '/usr/bin/git')
+          assert git.is_absolute() and not git.is_relative_to(root)
+          for item in [git,*git.parents]:
+              info=item.lstat()
+              assert not item.is_symlink() and not getattr(info,'st_file_attributes',0)&1024
+              assert (stat.S_ISREG(info.st_mode) and info.st_nlink==1) if item==git else stat.S_ISDIR(info.st_mode)
+          assert os.name=='nt' or git.stat().st_mode&0o111
+          head=os.environ['EXPECTED_HEAD'];name='tools/ci/qualify_preparation_integrity.py'
+          def raw(*args):
+              return subprocess.check_output([str(git),'--no-replace-objects','--no-optional-locks','-c','core.fsmonitor=false',*args],timeout=30)
+          assert raw('rev-parse','HEAD').decode().strip()==head
+          for path in [root,root/'tools',root/'tools/ci']:
+              info=path.lstat();assert stat.S_ISDIR(info.st_mode) and not path.is_symlink() and not getattr(info,'st_file_attributes',0)&1024
+          path=root/name;info=path.lstat()
+          assert stat.S_ISREG(info.st_mode) and info.st_nlink==1 and not getattr(info,'st_file_attributes',0)&1024
+          committed=raw('cat-file','blob',head+':'+name);assert path.read_bytes()==committed
+          print('QUALIFIER_BOOTSTRAP_SHA256',hashlib.sha256(committed).hexdigest(),flush=True)
+          base=pathlib.Path(os.environ['QUALIFICATION_BASE'])
+          sys.argv=[str(path),'--expected-head',head,'--evidence',str(base/'evidence'),'--zoneinfo',str(base/'dependency/tzdata/zoneinfo'),'--tzdata-wheel',str(base/'wheels/tzdata-2025.2-py2.py3-none-any.whl')]
+          exec(compile(committed,str(path),'exec'),dict(__name__='__main__',__file__=str(path)))
+          PY
+      - name: Preserve qualification evidence
+        id: evidence
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: preparation-${{ matrix.os }}-${{ github.event.pull_request.head.sha || github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ env.QUALIFICATION_BASE }}/
+          if-no-files-found: error
+      - name: Publish artifact identity and digest
+        if: always()
+        shell: bash
+        env:
+          ARTIFACT_ID: ${{ steps.evidence.outputs.artifact-id }}
+          ARTIFACT_DIGEST: ${{ steps.evidence.outputs.artifact-digest }}
+          ARTIFACT_URL: ${{ steps.evidence.outputs.artifact-url }}
+        run: |
+          python -I -S -B - <<'PY'
+          import os
+          assert os.environ['ARTIFACT_ID'] and len(os.environ['ARTIFACT_DIGEST'])==64
+          with open(os.environ['GITHUB_STEP_SUMMARY'],'a',encoding='utf-8') as stream:
+              for name in ('EXPECTED_HEAD','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','ARTIFACT_ID','ARTIFACT_DIGEST','ARTIFACT_URL'):
+                  stream.write(name+': '+os.environ[name]+'\n')
+              stream.write('Scope: local SQLite preparation only; no runtime/native/physical admission.\n')
+          PY
