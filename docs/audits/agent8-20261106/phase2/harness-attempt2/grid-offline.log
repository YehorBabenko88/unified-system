                leader.epoch = 42
                leader.coordination_lease = lease
                guard = floating_leader_guard(leader)
                assert await guard() == {'owner': 'node-a', 'epoch': 42}
                pool.live = False
                with pytest.raises(CoordinationLost): await guard()
                pool.live = True
                state['index'] += 1
                with pytest.raises(CoordinationLost): await guard()
