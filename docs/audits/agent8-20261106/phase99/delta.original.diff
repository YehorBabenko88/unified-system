+name: Gateway research principal native Consul
+on:
+  push:
+    paths: ['unified_system/gateway_research_identity.py', 'tests/gateway_research_identity/**', 'docs/intelligence/research-identity/**', '.github/workflows/gateway-research-identity.yml']
+  pull_request:
+    paths: ['unified_system/gateway_research_identity.py', 'tests/gateway_research_identity/**', 'docs/intelligence/research-identity/**', '.github/workflows/gateway-research-identity.yml']
+permissions:
+  contents: read
+jobs:
+  research-principal:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: windows-latest
+            lock: windows
+            executable: consul.exe
+          - os: ubuntu-24.04
+            lock: linux
+            executable: consul
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 15
+    env:
+      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+      A2_RESEARCH_CONSUL_BINARY: ${{ runner.temp }}/a2-research-consul/${{ matrix.executable }}
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        env:
+          GIT_CONFIG_COUNT: '1'
+          GIT_CONFIG_KEY_0: core.autocrlf
+          GIT_CONFIG_VALUE_0: 'false'
+        with:
+          ref: ${{ env.EXPECTED_HEAD }}
+          path: unified
+          persist-credentials: false
+          fetch-depth: 0
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        env:
+          GIT_CONFIG_COUNT: '1'
+          GIT_CONFIG_KEY_0: core.autocrlf
+          GIT_CONFIG_VALUE_0: 'false'
+        with:
+          repository: YehorBabenko88/bybit-cluster-grid
+          ref: 40e9c8dc274a2746018bc1aa08d103cd0187cecc
+          path: grid
+          persist-credentials: false
+          fetch-depth: 0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.10'
+      - shell: bash
+        run: |
+          python -m pip install --only-binary=:all: --require-hashes -r unified/docs/intelligence/research-identity/requirements-${{ matrix.lock }}.lock
+      - shell: bash
+        run: |
+          python -I -B unified/docs/intelligence/research-identity/fetch_consul.py --directory "$RUNNER_TEMP/a2-research-consul"
+      - shell: bash
+        run: |
+          set -o pipefail
+          python -I -B unified/docs/intelligence/research-identity/run_qualification.py --expected-head "$EXPECTED_HEAD" --grid-source "$GITHUB_WORKSPACE/grid" 2>&1 | tee "$RUNNER_TEMP/research-principal.log"
+      - if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: research-principal-${{ matrix.lock }}-${{ env.EXPECTED_HEAD }}
+          path: ${{ runner.temp }}/research-principal.log
+          if-no-files-found: warn
diff --git a/docs/intelligence/research-identity/fetch_consul.py b/docs/intelligence/research-identity/fetch_consul.py
new file mode 100644
index 0000000..24ced6c
--- /dev/null
+++ b/docs/intelligence/research-identity/fetch_consul.py
@@ -0,0 +1,28 @@
+"""Fetch one pinned disposable test binary; never installs a service."""
+import argparse
+import hashlib
+import io
+from pathlib import Path
+import sys
+import urllib.request
+import zipfile
+
+PINS={
+    'win32':('windows','consul.exe','41762ef5b98c8dd9b6852df6cfbceed37e7f0acc5760856be33100f1092475e1'),
+    'linux':('linux','consul','acb0a1b5b2a22a5fadb5d725f03610335e499e193eeade9df458c6c6017a77f4'),
+}
+parser=argparse.ArgumentParser();parser.add_argument('--directory',required=True);args=parser.parse_args()
+platform,name,pin=PINS[sys.platform]
+destination=Path(args.directory).absolute();destination.mkdir(parents=True,exist_ok=False)
+url='https://releases.hashicorp.com/consul/1.22.2/consul_1.22.2_'+platform+'_amd64.zip'
+with urllib.request.urlopen(url,timeout=60) as response:
+    raw=response.read(128*1024*1024+1)
+assert len(raw)<=128*1024*1024
+with zipfile.ZipFile(io.BytesIO(raw)) as archive:
+    member=archive.getinfo(name);assert member.file_size<=256*1024*1024
+    binary=archive.read(member)
+assert hashlib.sha256(binary).hexdigest()==pin
+target=destination/name
+with target.open('xb') as stream:stream.write(binary)
+if sys.platform=='linux':target.chmod(0o700)
+print(str(target))
