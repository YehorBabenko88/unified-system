+name: Gateway research principal native Consul
+on:
+  push:
+    paths: ['unified_system/gateway_research_identity.py', 'tests/gateway_research_identity/**', 'docs/intelligence/research-identity/**', '.github/workflows/gateway-research-identity.yml']
+  pull_request:
+    paths: ['unified_system/gateway_research_identity.py', 'tests/gateway_research_identity/**', 'docs/intelligence/research-identity/**', '.github/workflows/gateway-research-identity.yml']
+permissions:
+  contents: read
+jobs:
+  research-principal:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: windows-latest
+            lock: windows
+            executable: consul.exe
+          - os: ubuntu-24.04
+            lock: linux
+            executable: consul
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 15
+    env:
+      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        env:
+          GIT_CONFIG_COUNT: '1'
+          GIT_CONFIG_KEY_0: core.autocrlf
+          GIT_CONFIG_VALUE_0: 'false'
+        with:
+          ref: ${{ env.EXPECTED_HEAD }}
+          path: unified
+          persist-credentials: false
+          fetch-depth: 0
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        env:
+          GIT_CONFIG_COUNT: '1'
+          GIT_CONFIG_KEY_0: core.autocrlf
+          GIT_CONFIG_VALUE_0: 'false'
+        with:
+          repository: YehorBabenko88/bybit-cluster-grid
+          ref: 40e9c8dc274a2746018bc1aa08d103cd0187cecc
+          path: grid
+          persist-credentials: false
+          fetch-depth: 0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.10'
+      - shell: bash
+        run: |
+          python -m pip install --only-binary=:all: --require-hashes -r unified/docs/intelligence/research-identity/requirements-${{ matrix.lock }}.lock
+      - shell: bash
+        run: |
+          python -I -B unified/docs/intelligence/research-identity/fetch_consul.py --directory "$RUNNER_TEMP/a2-research-consul"
+      - shell: bash
+        env:
+          A2_RESEARCH_CONSUL_BINARY: ${{ runner.temp }}/a2-research-consul/${{ matrix.executable }}
+        run: |
+          set -o pipefail
+          python -I -B unified/docs/intelligence/research-identity/native-profile-v2-20261109/run_qualification.py --expected-head "$EXPECTED_HEAD" --grid-source "$GITHUB_WORKSPACE/grid" --expected-grid-head 40e9c8dc274a2746018bc1aa08d103cd0187cecc 2>&1 | tee "$RUNNER_TEMP/research-principal.log"
+      - if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: research-principal-${{ matrix.lock }}-${{ env.EXPECTED_HEAD }}
+          path: ${{ runner.temp }}/research-principal.log
+          if-no-files-found: warn
