+            before=int(info.ActiveProcesses);total=int(info.TotalProcesses)
+            accounting=dict(raw_hex=bytes(info).hex(),size=ctypes.sizeof(info),
+                            offsets={field:getattr(type(info),field).offset for field,*_ in info._fields_},
