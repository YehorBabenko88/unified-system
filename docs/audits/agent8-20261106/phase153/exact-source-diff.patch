+'use strict';
+const {test}=require('node:test'),assert=require('node:assert/strict'),{cleanupIssued}=require('./owned_lifecycle.cjs');
+function telemetry(after){return {step:async(phase,fn)=>{const result=await fn();if(after)after(phase);return result;}};}
+function handles(http){const child={pid:123,exitCode:0,signalCode:null};return {browserServer:{close:async()=>{},process:()=>child},httpServer:{closeAllConnections(){},close:cb=>http(cb)}};}
+async function clocked(fn){const original=process.hrtime.bigint;let ns=0n;process.hrtime.bigint=()=>ns;try{return await fn(ms=>{ns=BigInt(ms)*1000000n;});}finally{process.hrtime.bigint=original;}}
+test('late synchronous final HTTP completion rejects even before timeout callback runs',()=>clocked(async set=>{const r=await cleanupIssued(handles(cb=>{set(11000);cb();}),telemetry());assert.equal(r.confirmed,false);assert.equal(r.http,'UNKNOWN');assert.equal(r.expired,true);assert.equal(r.deadline_expired,true);assert.equal(r.expiration_phase,'HTTP_CLOSE');assert.equal(r.observed_elapsed_ms,11000);}));
+test('per-operation 5s deadline also rejects before common 10s is exhausted',()=>clocked(async set=>{const r=await cleanupIssued(handles(cb=>{set(6000);cb();}),telemetry());assert.equal(r.confirmed,false);assert.equal(r.expired,true);assert.equal(r.deadline_expired,false);assert.equal(r.http,'UNKNOWN');}));
+test('final monotonic confirmation rejects time consumed after operation completes',()=>clocked(async set=>{const r=await cleanupIssued(handles(cb=>cb()),telemetry(phase=>{if(phase==='HTTP_CLOSE')set(10000);}));assert.equal(r.confirmed,false);assert.equal(r.deadline_expired,true);assert.equal(r.expired,true);}));
+test('under-deadline completion remains separately confirmed with bounded elapsed evidence',()=>clocked(async set=>{const r=await cleanupIssued(handles(cb=>{set(4);cb();}),telemetry());assert.equal(r.confirmed,true);assert.equal(r.expired,false);assert.equal(r.deadline_expired,false);assert.equal(r.observed_elapsed_ms,4);assert.equal(r.budget_ms,10000);}));
+test('final confirmation independently rejects microtask delay after last attempt postcheck',()=>clocked(async set=>{const t={step:(phase,fn)=>Promise.resolve().then(fn).then(value=>{if(phase==='HTTP_CLOSE')queueMicrotask(()=>queueMicrotask(()=>set(10000)));return value;})};const r=await cleanupIssued(handles(cb=>cb()),t);assert.equal(r.http,'CLOSED');assert.equal(r.expiration_phase,'FINAL_CONFIRM');assert.equal(r.confirmed,false);assert.equal(r.deadline_expired,true);}));
