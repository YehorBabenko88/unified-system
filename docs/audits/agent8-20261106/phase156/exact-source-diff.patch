diff --git a/tests/fresh_render/test_loopback_resolver.cjs b/tests/fresh_render/test_loopback_resolver.cjs
new file mode 100644
index 0000000..c56495a
--- /dev/null
+++ b/tests/fresh_render/test_loopback_resolver.cjs
@@ -0,0 +1,9 @@
+'use strict';
+const {test}=require('node:test'),assert=require('node:assert/strict'),path=require('node:path'),fs=require('node:fs'),h=require('./harness.cjs');
+const tmp=path.resolve('inert-own-temp'),exe=path.resolve('inert-chromium.exe'),base='http://127.0.0.1:43123';
+test('canonical wildcard deny explicitly excludes only intended numeric loopback plus existing localhost',()=>{const args=h.launchOptions(tmp,exe).args,rule=args.filter(x=>x.startsWith('--host-resolver-rules='));assert.deepEqual(rule,['--host-resolver-rules=MAP * ^NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1']);assert.ok(!rule[0].includes('~NOTFOUND'));assert.ok(!rule[0].includes('127.*'));assert.ok(!rule[0].includes('EXCLUDE *'));assert.ok(!rule[0].includes('EXCLUDE 192.168'));});
+test('launch option correction adds no proxy TLS or sandbox weakening',()=>{const o=h.launchOptions(tmp,exe);assert.equal(o.chromiumSandbox,true);assert.equal(o.host,'127.0.0.1');assert.equal(o.port,0);assert.equal(o.args.length,2);assert.equal(o.args[0],'--disk-cache-dir='+path.join(tmp,'cache'));for(const flag of o.args)assert.ok(!/proxy-server|proxy-bypass|ignore-certificate|disable-web-security|no-sandbox/.test(flag));});
+test('page gate admits only fixed GET routes on its precise numeric host and port',()=>{for(const p of ['/','/renderer.js','/packet.js'])assert.equal(h.allowRequest(base,base+p,'GET'),true);for(const p of ['/?q=1','/artifact.json','/../','/%2e/'])assert.equal(h.allowRequest(base,base+p,'GET'),false);assert.equal(h.allowRequest(base,base+'/','POST'),false);for(const url of ['http://127.0.0.1:43124/','https://127.0.0.1:43123/','http://user@127.0.0.1:43123/','file:///127.0.0.1/','http://127.0.0.1.evil.invalid:43123/'])assert.equal(h.allowRequest(base,url,'GET'),false);});
+test('external LAN and distinct loopback endpoint strings remain outside page gate',()=>{for(const host of ['example.invalid','192.168.1.10','10.0.0.1','172.16.0.1','169.254.169.254','127.0.0.2','127.0.1.1','[::1]','localhost'])assert.equal(h.allowRequest(base,'http://'+host+':43123/','GET'),false,host);});
+test('CSP route boundary remains connect-none and does not become arbitrary static serving',()=>{const r=h.routeFor({},'GET','/');assert.match(r.headers['Content-Security-Policy'],/connect-src 'none'/);assert.match(r.headers['Content-Security-Policy'],/default-src 'none'/);assert.equal(h.routeFor({},'GET','/unknown').status,404);assert.equal(h.routeFor({},'POST','/').status,405);});
+test('rule is bound to exact reviewed141 primary blobs and both resolver overloads',()=>{const m=JSON.parse(fs.readFileSync(path.join(__dirname,'CHROMIUM-141-SOURCE.json'),'utf8'));assert.equal(m.tag,'141.0.7390.37');assert.equal(m.scope,'PRIMARY_SOURCE_REVIEW_NOT_BROWSER_EXECUTION_OR_DNS_PROOF');assert.equal(m.canonical_rule,'MAP * ^NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1');assert.equal(h.launchOptions(tmp,exe).args[1],'--host-resolver-rules='+m.canonical_rule);assert.deepEqual(m.sources.map(x=>[x.path,x.git_blob,x.sha256]),[['net/base/host_mapping_rules.cc','fec058db4f7c10062355f1f2f9ef5093eb0eeb54','f3d7dacea880c41b7bd9f7136cee600a5ad54a0659be4f21136f039e8338e82d'],['net/dns/mapped_host_resolver.cc','588fac6bc4f797e2ddf5dcf9d1782b66093b19a8','4046c3aba6efef8f66ac7bb2bfdb6fd47ed7382f241001ad7abaded84906e2d7']]);assert.deepEqual(Object.keys(m.reviewed_paths),['HostMappingRules.RewriteHost','MappedHostResolver.CreateRequest.SchemeHostPort','MappedHostResolver.CreateRequest.HostPortPair']);});
