{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "request_id",
    "request_sha256",
    "target_capability",
    "target_version",
    "experiment_id",
    "dataset",
    "parameters_digest",
    "execution_mode",
    "resource_budget",
    "result",
    "research_descriptor",
    "result_artifact_ref",
    "publication_status",
    "execution_authority",
    "scheduler_admission",
    "authenticated_gateway",
    "physical_acceptance",
    "error",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "unified.gateway.direct-target-result.v2"
    },
    "status": {
      "enum": [
        "CANCELLED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "request_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "target_capability": {
      "type": "string",
      "const": "terminan.ohlcv.untouched_levels.v1"
    },
    "target_version": {
      "type": "string",
      "const": "e8b7785e47f4bbfbe41fc6f51d3893592a7c849d"
    },
    "experiment_id": {
      "type": "string",
      "const": "fixture.gateway.btc.levels"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "revision",
        "raw_sha256",
        "kind"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "const": "local-sha256:44639dea28a646d2a308655d7adc3f85e24a90bda22971632f88d1dd9760c938"
        },
        "revision": {
          "type": "string",
          "const": "CANONICAL_FIXTURE_2"
        },
        "raw_sha256": {
          "type": "string",
          "const": "44639dea28a646d2a308655d7adc3f85e24a90bda22971632f88d1dd9760c938"
        },
        "kind": {
          "type": "string",
          "const": "FIXED_SYNTHETIC_LOCAL_NOT_QUALIFIED_MARKET_DATA"
        }
      }
    },
    "parameters_digest": {
      "type": "string",
      "const": "4a8b7be2fa7cfbf72399e4abf864287feb8b10a28977aea2970846b8fb97e7e9"
    },
    "execution_mode": {
      "type": "string",
      "const": "DIRECT_DISPOSABLE_SYNTHETIC"
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_bytes",
        "max_output_bytes",
        "max_rows",
        "max_executions"
      ],
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "const": 16384
        },
        "max_output_bytes": {
          "type": "integer",
          "const": 16384
        },
        "max_rows": {
          "type": "integer",
          "const": 3
        },
        "max_executions": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "result": {
      "type": "null"
    },
    "research_descriptor": {
      "type": "null"
    },
    "result_artifact_ref": {
      "type": "null"
    },
    "publication_status": {
      "type": "string",
      "const": "LOCAL_UNATTESTED"
    },
    "execution_authority": {
      "type": "boolean",
      "const": false
    },
    "scheduler_admission": {
      "type": "string",
      "const": "BLOCKED"
    },
    "authenticated_gateway": {
      "type": "boolean",
      "const": false
    },
    "physical_acceptance": {
      "type": "boolean",
      "const": false
    },
    "error": {
      "enum": [
        "LOCAL_CANCELLED",
        "TARGET_RESULT_UNAVAILABLE",
        "ORIGINAL_INTENT_OUTCOME_UNKNOWN_NO_REEXECUTION"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminan_head",
        "math_head",
        "research_input_sha256"
      ],
      "properties": {
        "terminan_head": {
          "type": "string",
          "const": "e8b7785e47f4bbfbe41fc6f51d3893592a7c849d"
        },
        "math_head": {
          "type": "string",
          "const": "420290fa9a3d918903673d86d714feb5d9492aca"
        },
        "research_input_sha256": {
          "type": "string",
          "const": "4a8b7be2fa7cfbf72399e4abf864287feb8b10a28977aea2970846b8fb97e7e9"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "string",
          "const": "LOCAL_TEST_SCOPE_NOT_AUTHENTICATED"
        },
        {
          "type": "string",
          "const": "NO_NATIVE_RESOURCE_CONTAINMENT"
        },
        {
          "type": "string",
          "const": "NO_REPLICA_OR_PUBLICATION_PROOF"
        },
        {
          "type": "string",
          "const": "NO_ORDERS_NO_LEDGER"
        },
        {
          "type": "string",
          "const": "WHOLE_WINDOW_NOT_HISTORICAL_SIGNAL"
        }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CANCELLED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "const": "LOCAL_CANCELLED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "const": "TARGET_RESULT_UNAVAILABLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "enum": [
              "TARGET_RESULT_UNAVAILABLE",
              "ORIGINAL_INTENT_OUTCOME_UNKNOWN_NO_REEXECUTION"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unified:gateway:canonical-target:refusal-result:v2"
}
