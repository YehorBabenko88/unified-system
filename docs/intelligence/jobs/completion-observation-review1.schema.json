{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unified:gateway:job-completion-observation:v1-review1",
  "description": "Untrusted candidate observation DATA only, never receipt proof/admission. For known actual native commit only; does not describe other job states.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.gateway.job-completion-observation.v1-review1"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "job_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "execution_attempt_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "publication_request_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "publication_intent_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "input_request_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "cluster_id",
            "job_id",
            "execution_attempt_id",
            "publication_request_id",
            "publication_intent_sha256",
            "input_request_sha256",
            "artifact_sha256"
          ]
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "COMMITTED"
            },
            "receipt_bytes_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "state",
            "receipt_bytes_sha256"
          ]
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "DURABLE"
            },
            "projection_identity_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "state",
            "projection_identity_sha256"
          ]
        },
        "job_state": {
          "const": "COMPLETED"
        }
      },
      "required": [
        "schema",
        "identity",
        "publication",
        "projection",
        "job_state"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "unified.gateway.job-completion-observation.v1-review1"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "job_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "execution_attempt_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "publication_request_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "publication_intent_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "input_request_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "cluster_id",
            "job_id",
            "execution_attempt_id",
            "publication_request_id",
            "publication_intent_sha256",
            "input_request_sha256",
            "artifact_sha256"
          ]
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "COMMITTED"
            },
            "receipt_bytes_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "state",
            "receipt_bytes_sha256"
          ]
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PENDING",
                "UNKNOWN",
                "FAILED"
              ]
            }
          },
          "required": [
            "state"
          ]
        },
        "job_state": {
          "const": "RESULT_PROJECTION_PENDING"
        }
      },
      "required": [
        "schema",
        "identity",
        "publication",
        "projection",
        "job_state"
      ]
    }
  ]
}
